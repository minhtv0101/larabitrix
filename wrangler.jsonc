{
  "name": "larabitrix",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"]

  // SCHEMA_KV là tuỳ chọn — không cần thiết để chạy.
  // Nếu muốn cache schema lâu dài (giảm Bitrix API calls khi Worker restart):
  //   1. wrangler kv namespace create SCHEMA_KV
  //   2. Uncomment và điền id bên dưới:
  // "kv_namespaces": [{ "binding": "SCHEMA_KV", "id": "<id-từ-bước-trên>" }]
}
